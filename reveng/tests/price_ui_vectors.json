  "reader_precision_cases": [
    {
      "name": "decimal_zero",
      "candidate_json": "{\"price_experiment\":{\"status\":\"proposed_unverified\",\"amount\":0.0,\"currency\":\"USD\"}}",
      "meaning": "Native JSON-reader precision case; must never infer exact free offer from decoded zero"
    },
    {
      "name": "tiny_positive",
      "candidate_json": "{\"price_experiment\":{\"status\":\"proposed_unverified\",\"amount\":1e-30,\"currency\":\"USD\"}}",
      "meaning": "Native JSON-reader precision case; must never infer exact free offer from decoded zero"
    },
    {
      "name": "tiny_negative",
      "candidate_json": "{\"price_experiment\":{\"status\":\"proposed_unverified\",\"amount\":-1e-30,\"currency\":\"USD\"}}",
      "meaning": "Native JSON-reader precision case; must never infer exact free offer from decoded zero"
    },
    {
      "name": "tinier_positive",
      "candidate_json": "{\"price_experiment\":{\"status\":\"proposed_unverified\",\"amount\":1e-100,\"currency\":\"USD\"}}",
      "meaning": "Native JSON-reader precision case; must never infer exact free offer from decoded zero"
    },
    {
      "name": "tinier_negative",
      "candidate_json": "{\"price_experiment\":{\"status\":\"proposed_unverified\",\"amount\":-1e-100,\"currency\":\"USD\"}}",
      "meaning": "Native JSON-reader precision case; must never infer exact free offer from decoded zero"
    },
    {
      "name": "high_precision_fraction",
      "candidate_json": "{\"price_experiment\":{\"status\":\"proposed_unverified\",\"amount\":1.23456789012345678901234567890123456789,\"currency\":\"USD\"}}",
      "meaning": "Native JSON-reader precision case; must never infer exact free offer from decoded zero"
    }
  ]
