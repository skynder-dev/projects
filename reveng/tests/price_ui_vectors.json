      "free_test": false
    },
    {
      "name": "scalar",
      "candidate": {
        "price_experiment": "10 USD"
      },
      "expected_status": "malformed_untrusted_offer",
      "expected_display": null,
      "free_test": false
    },
    {
      "name": "array",
      "candidate": {
        "price_experiment": []
      },
      "expected_status": "malformed_untrusted_offer",
      "expected_display": null,
      "free_test": false
    }
